# Copy thành .env khi chạy local. KHÔNG commit .env (đã gitignore).
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

JWT_SECRET=doi-secret-manh-o-day
# Khuyến nghị tách secret access/refresh ở production:
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# Groq AI (https://console.groq.com)
GROQ_API_KEY=gsk_...
# Mặc định: qwen/qwen3.8-27b
# GROQ_MODEL=

# Google login — BẮT BUỘC là Web application client ID (khớp EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID ở FE)
GOOGLE_WEB_CLIENT_ID=
# GOOGLE_CLIENT_SECRET= (chỉ dùng cho OAuth web flow, hiện chưa dùng)
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Mail (hiện chưa dùng trong code — cấu hình khi cần)
# MAIL_HOST=smtp.gmail.com
# MAIL_USER=
# MAIL_PASS=

# Bật log request body (chỉ dev)
# LOG_REQUEST_BODY=true
